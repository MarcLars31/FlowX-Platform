# Supabase server configuration (never expose the secret key in browser code)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="replace-with-server-secret"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"

# Existing standalone Product PDF Extractor service
PRODUCT_PDF_EXTRACTOR_URL="http://127.0.0.1:8080/"
PRODUCT_PDF_EXTRACTOR_TIMEOUT_MS="120000"
PRODUCT_PDF_READER_VERSION="product-pdf-extractor/1.0.0"

# Shared secret used only by the document crawler ingestion endpoint.
# Generate a random value of at least 32 characters.
CRAWLER_INGEST_TOKEN="replace-with-a-long-random-secret"

# Sprsok source API (server/CLI only; never expose the token to browser code)
SPRSOK_API_URL="https://verified-sprsok-endpoint.example/products"
SPRSOK_API_TOKEN="replace-with-source-api-token"
SPRSOK_API_PAGINATION="cursor"
SPRSOK_API_PAGE_SIZE="100"
SPRSOK_API_TIMEOUT_MS="30000"
SPRSOK_API_RATE_LIMIT_MS="250"
SPRSOK_API_MAX_RESPONSE_BYTES="10000000"
SPRSOK_API_CURSOR_PARAM="cursor"
SPRSOK_API_OFFSET_PARAM="offset"
SPRSOK_API_LIMIT_PARAM="limit"
# Required in addition to an explicit --apply/--repair or confirmed admin action.
PRODUCT_SYNC_WRITES_ENABLED="false"
