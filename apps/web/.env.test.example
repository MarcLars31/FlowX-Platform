# Copy to .env.test.local or inject these values through your test/staging
# secret manager. Never reuse these values in production.
TEST_ACCOUNT_SEEDING_ENABLED="true"
TEST_ACCOUNT_ENVIRONMENT="test"
TEST_ACCOUNT_PASSWORD="replace-with-a-unique-local-test-secret"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-local-service-role-key"

# Required for every remote test/staging database. Use only the bare hostname
# from SUPABASE_URL. The HTTP readiness gate also requires an exact pin for a
# local database, so the example matches the local Supabase URL above.
TEST_ACCOUNT_EXPECTED_SUPABASE_HOST="127.0.0.1"

# Always denied by the seed/remove commands, even if the expected-host pin
# matches. The Scipx production Supabase host is also hard-coded as a safe
# default; keep it here so environment intent remains explicit and auditable.
TEST_ACCOUNT_PRODUCTION_HOSTS="myzegtifgbvjhdlcpebi.supabase.co"

# Optional full HTTP test after the four accounts have been seeded and the web
# application is running. The suite is skipped unless explicitly enabled.
RUN_TEST_ACCOUNT_E2E="false"
E2E_BASE_URL="http://127.0.0.1:3000"

# These values must be injected into both the web-server runtime and the test
# runner. Keep support disabled except during an isolated E2E run. Replace the
# placeholder with a unique random value of at least 32 bytes; never commit it.
TEST_ACCOUNT_E2E_SUPPORT_ENABLED="false"
TEST_ACCOUNT_E2E_READINESS_TOKEN="replace-with-a-random-32-byte-test-only-secret"

# Independent runner-side assertion of the host reported by the server-side
# readiness gate. This must match TEST_ACCOUNT_EXPECTED_SUPABASE_HOST.
E2E_EXPECTED_SUPABASE_HOST="127.0.0.1"

# Set this only when a published test datasheet fixture exists.
E2E_PRODUCT_DOCUMENT_ID=""

# Remote staging requires all three settings. Never use a production hostname.
E2E_ALLOW_REMOTE_STAGING="false"
E2E_EXPECTED_HOST=""
E2E_PRODUCTION_HOSTS="scipx.ai,www.scipx.ai"
