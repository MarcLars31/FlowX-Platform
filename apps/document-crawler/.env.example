# Identifiera tjänsten och ange en övervakad kontaktadress.
SCIPX_CRAWLER_USER_AGENT="ScipxDocumentCrawler/0.1 (+https://www.scipx.ai/crawler)"

# Valfri befintlig, separat FastAPI-extractor. Tom URL stänger av integrationen.
SCIPX_EXTRACTOR_URL=""
SCIPX_EXTRACTOR_ENABLED="false"

# Valfri FlowX-ingest. URL ska vara hela endpointen nedan; token ska hållas hemlig.
SCIPX_FLOWX_INGEST_ENABLED="false"
SCIPX_FLOWX_INGEST_URL="https://www.scipx.ai/api/pkms/document-processing/ingest"
SCIPX_FLOWX_INGEST_TOKEN=""
